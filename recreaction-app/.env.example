# Copiez ce fichier en .env.local pour travailler sur votre ordinateur.
# En ligne, ces valeurs se mettent dans Netlify : Site configuration > Environment variables.

# Supabase : Project Settings > API Keys
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe : Développeurs > Clés API, puis Développeurs > Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
